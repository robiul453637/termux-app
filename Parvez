# ================================
# 1️⃣ Enable Hyper-V (if not already)
# ================================
Enable-WindowsOptionalFeature -Online -FeatureName Microsoft-Hyper-V -All -NoRestart

# ================================
# 2️⃣ Create VM
# ================================
$VMName = "Win10-22H2"
$VHDPath = "C:\VMs\$VMName.vhdx"
$ISOPath = "C:\ISOs\Win10_22H2_English_x64_19045.2006.iso"
$SwitchName = "Wi-Fi"  # Change to your network adapter name

New-VM -Name $VMName -MemoryStartupBytes 4GB -Generation 2 -NewVHDPath $VHDPath -NewVHDSizeBytes 50GB -SwitchName $SwitchName

# ================================
# 3️⃣ Mount ISO
# ================================
Set-VMDvdDrive -VMName $VMName -Path $ISOPath

# ================================
# 4️⃣ Start VM
# ================================
Start-VM -Name $VMName

# ================================
# 5️⃣ Optional: Configure RDP (after OS install)
# ================================
# Enable Remote Desktop
# Set-ItemProperty -Path "HKLM:\System\CurrentControlSet\Control\Terminal Server" -Name "fDenyTSConnections" -Value 0
# Open Firewall Port 3389
# New-NetFirewallRule -DisplayName "RDP" -Direction Inbound -Protocol TCP -LocalPort 3389 -Action Allow

Write-Host "VM $VMName is created and started! Install Windows 10 from ISO."
